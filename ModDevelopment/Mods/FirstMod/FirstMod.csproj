<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\..</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UnityEngine facade references mscorlib 4.0, while this game's Mono runtime and CoreModule use 2.0. -->
    <Reference Include="BepInEx, Version=5.4.23.6, Culture=neutral, PublicKeyToken=null">
      <HintPath>$(GameDirectory)\BepInEx\core\BepInEx.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>$(GameDirectory)\BadNorth_Data\Managed\UnityEngine.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDirectory)\BadNorth_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
