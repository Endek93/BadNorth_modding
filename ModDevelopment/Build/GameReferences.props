<Project>
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(MSBuildThisFileDirectory)..\..</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx, Version=5.4.23.6, Culture=neutral, PublicKeyToken=null">
      <HintPath>$(GameDirectory)\BepInEx\core\BepInEx.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <!-- The game ships a UnityEngine facade that refers to a different mscorlib than CoreModule does. -->
    <Reference Include="UnityEngine, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>$(GameDirectory)\BadNorth_Data\Managed\UnityEngine.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDirectory)\BadNorth_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>$(GameDirectory)\BadNorth_Data\Managed\Assembly-CSharp.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
